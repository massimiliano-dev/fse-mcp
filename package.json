{
  "name": "@massimiliano-dev/fse-mcp",
  "version": "0.0.0",
  "description": "Unofficial MCP server that explains why a CDA2 document is rejected by Italy's FSE 2.0 gateway: local validation, schematron error explanations, code lookup, synthetic sample CDAs.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/fse-mcp.git"
  },
  "homepage": "https://github.com/massimiliano-dev/fse-mcp#readme",
  "bugs": "https://github.com/massimiliano-dev/fse-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fse",
    "fascicolo-sanitario-elettronico",
    "cda",
    "hl7",
    "schematron",
    "healthcare",
    "italy"
  ],
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "fse-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "inspect": "pnpm build && mcp-inspector node dist/bin.js",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.12.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "@massimiliano-dev/fse-validator": "link:../fse-client/packages/validator"
  },
  "peerDependencies": {
    "@massimiliano-dev/fse-validator": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@massimiliano-dev/fse-validator": {
      "optional": true
    }
  }
}
